# Docker Compose Environment Variables
# Copy this to .env at the root of the project for docker-compose

# PostgreSQL Configuration
POSTGRES_USER=vaultguard
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION
POSTGRES_DB=vault_guard

# Database URL (used by API)
DATABASE_URL=postgresql://vaultguard:CHANGE_THIS_IN_PRODUCTION@postgres:5432/vault_guard

# Redis URL
REDIS_URL=redis://redis:6379

# API Configuration
NODE_ENV=production
PORT=3001
ENABLE_WORKER=true
SUI_NETWORK=testnet

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:80

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend Configuration
VITE_PACKAGE_ID=0x4eb541917d237dd2c932a4c7d79840c5c943a262ecf009bdbd855c528187ed6b
VITE_API_URL=http://localhost:3001

# SECURITY NOTE: 
# Before deploying to production:
# 1. Change POSTGRES_PASSWORD to a strong random password
# 2. Update DATABASE_URL with the new password
# 3. Update CORS_ORIGINS with your actual domain(s)
# 4. Set proper VITE_API_URL for your production API
